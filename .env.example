# Copie para .env.local (ou .env) e preencha. Nunca comite com valores.
#
# Não há variáveis "ENABLED": cada recurso aparece sozinho quando as chaves
# dele estão preenchidas (lib/recursos.ts). Deixe em branco o que não usar —
# o app continua funcionando no modo manual, sem custo.

# ──────────────────────────────────────────────────────────────────────────
# Login com Google + banco (Neon) — sem isso: modo anônimo, só no navegador
# ──────────────────────────────────────────────────────────────────────────
# Passo a passo no README ("Ligar login + banco").
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vincular o Discord à conta (opcional). App em discord.com/developers, com o
# redirect <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# AWS S3 — imagens e vídeos (exige login)
# ──────────────────────────────────────────────────────────────────────────
# Bucket privado + CORS + usuário IAM (README: "Armazenamento de arquivos").
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Cron diário (Vercel): limpa arquivos órfãos do S3 e contadores antigos.
# String aleatória longa; a Vercel envia "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Anthropic — IA de texto (expandir ficha, sugerir campo, regenerar, checar)
# ──────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Só se a chave não for de um workspace (a API pede o ID): Console → Settings → Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# RATE_LIMIT_PER_MINUTE=10

# ──────────────────────────────────────────────────────────────────────────
# Gemini — imagens com Nano Banana
# ──────────────────────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey (com faturamento ativo: o plano grátis
# não gera imagem).
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image
# GEMINI_TEXT_MODEL=gemini-flash-latest   # descreve quem trocar no vídeo
# IMAGE_RATE_LIMIT_PER_MINUTE=5
# IMAGE_DAILY_LIMIT=30

# ──────────────────────────────────────────────────────────────────────────
# fal.ai — Seedream 4.5, Flux.2 Pro, GPT Image + troca de pessoa (Kling O3 / Seedance 2.5)
# ──────────────────────────────────────────────────────────────────────────
# https://fal.ai/dashboard/keys (conta com créditos). A troca de vídeo exige S3.
FAL_KEY=

# ──────────────────────────────────────────────────────────────────────────
# OpenAI — GPT Image direto na API da OpenAI (opcional)
# ──────────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys (conta com saldo e organização verificada).
# Com a chave, o GPT Image deixa de passar pelo fal; sem ela, continua no fal.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# VIDEO_MAX_SECONDS=60        # duração máxima por vídeo
# VIDEO_DAILY_SECONDS=180     # cota diária de vídeo por conta

# ──────────────────────────────────────────────────────────────────────────
# Runway — Criar vídeo (Gen-4 / Veo)
# ──────────────────────────────────────────────────────────────────────────
# https://dev.runwayml.com → API Keys (cobrada à parte da assinatura do app).
RUNWAYML_API_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Pagamentos — planos e créditos (exigem login)
# ──────────────────────────────────────────────────────────────────────────
# Stripe (BRL: cartão, Pix, boleto). Dashboard → Developers → API keys.
# Webhook: https://aistudio.nido.global/api/pagamentos/stripe/webhook (eventos no README).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# USDC na Solana (Solana Pay). Carteira que RECEBE os pagamentos.
SOLANA_MERCHANT_WALLET=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # use um RPC dedicado em produção
# SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v   # devnet: mint de teste

# USDC nas redes EVM. Carteira 0x… que RECEBE (a mesma em todas as redes).
# Cada rede só aparece no app se tiver o RPC preenchido. O RPC é chamado pelo
# servidor: não pode ter restrição de origem/domínio (allowlist) no provedor.
EVM_MERCHANT_WALLET=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
BSC_RPC_URL=
ETHEREUM_RPC_URL=

# Indicações: saque de comissão em USDC on-chain (lib/indicacao/onchain.ts).
# Chaves da carteira que ENVIA os saques. Use uma carteira só para isso, com
# pouco saldo (não a que recebe os pagamentos): quem tem a chave move o dinheiro.
# Sem a chave, o saque em USDC fica desligado naquela rede.
# EVM: chave privada 0x… (64 hexadecimais). Vale para as redes com RPC acima;
# a carteira precisa de USDC e da moeda da taxa (ETH, BNB) em cada uma.
# USDC_SAQUE_EVM_PRIVATE_KEY=
# Solana: chave secreta em JSON, [12,34,…] com 64 números (arquivo do solana-keygen).
# A carteira precisa de USDC e de SOL para a taxa.
# USDC_SAQUE_SOLANA_SECRET_KEY=
# Maior saque automático, em USDC (padrão 200). Acima disso, o usuário é mandado ao suporte.
# USDC_SAQUE_TETO=200
# Soma máxima de saques em USDC em 24 horas, de todos os usuários (padrão 1000).
# USDC_SAQUE_TETO_DIA=1000

# ──────────────────────────────────────────────────────────────────────────
# ElevenLabs — voz do personagem (criar pela descrição, clonar, gerar falas)
# ──────────────────────────────────────────────────────────────────────────
# https://elevenlabs.io → Developers → API Keys. Clonagem exige plano pago.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ──────────────────────────────────────────────────────────────────────────
# bundle.social — publicar e agendar posts (Instagram, TikTok, YouTube Shorts, X, LinkedIn)
# ──────────────────────────────────────────────────────────────────────────
# https://bundle.social → API Keys (chave da organização). Um "time" por influencer é criado sozinho.
BUNDLE_SOCIAL=
# Webhook (opcional, recomendado): no painel → Webhooks → URL https://aistudio.nido.global/api/social/webhook,
# evento post.published; cole aqui o segredo de assinatura. Sem ele, a tela confere o status ao abrir.
# BUNDLE_SOCIAL_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Apify — "Colar link" de vídeo (TikTok, Instagram, YouTube Shorts)
# ──────────────────────────────────────────────────────────────────────────
# https://console.apify.com → Settings → API & Integrations → Personal API token.
# Sem a chave, só links diretos de .mp4/.mov/.webm funcionam.
APIFY_TOKEN=
# Actors (opcional — troque sem mexer no código):
# APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper
# APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
# APIFY_ACTOR_YOUTUBE=maximedupre/youtube-shorts-downloader

# twitterapi.io — "Colar link" de vídeo de posts do X (x.com/perfil/status/…)
# https://twitterapi.io/dashboard → API Key. Sem a chave, links do X são recusados.
TWITTER_API_KEY=

# Editar legenda de vídeo não precisa de chave (usa ffmpeg no servidor).

# Área admin (/app/admin): e-mails com acesso, separados por vírgula.
# Sem esta variável vale a lista padrão de lib/admin/acesso.ts.
# ADMIN_EMAILS=voce@exemplo.com,socio@exemplo.com
# Reais por dólar na aba Lucro do admin (soma receita em BRL e USD). Padrão: 5.3.
# CAMBIO_USD_BRL=5.3

# Radar (Estúdio → Radar): o que está em alta nos temas do personagem.
# As notícias usam a busca na web da Anthropic (ANTHROPIC_API_KEY) — não precisa de mais nada.
# Para incluir o que está em alta no X, crie uma chave em console.x.ai:
# XAI_API_KEY=
# XAI_MODEL=grok-4.3
# RADAR_MODEL=claude-haiku-4-5-20251001
# Radar global (/app/radar): idiomas montados todo dia e se usa o X. Cada radar custa ~US$ 0,15 (~US$ 0,09 sem o X).
# RADAR_GLOBAL_IDIOMAS=pt,en
# RADAR_GLOBAL_X=1

# Ligação com o Nido (plataforma de campanhas, projeto nido-api). Com as duas
# preenchidas, o Dashboard mostra os ganhos e as campanhas do usuário no Nido
# e as campanhas exclusivas do Studio; e o Nido passa a poder confirmar quem
# tem conta aqui. Sem elas, nada disso aparece.
# Endereço da API do Nido (sem barra no fim).
NIDO_API_URL=
# Segredo combinado entre os dois servidores. O MESMO valor vai no nido-api,
# em STUDIO_INTEGRATION_SECRET. Gere um valor longo e aleatório.
NIDO_INTEGRACAO_SEGREDO=
